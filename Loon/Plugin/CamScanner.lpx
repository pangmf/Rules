[Script]
http-response ^https:\/\/.*\.(intsig\.net|camscanner\.com) script-path=https://raw.githubusercontent.com/pangmf/Rules/refs/heads/master/Loon/task/CamScanner.js, requires-body=true, timeout=60, tag=CamScanner, img-url=https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/camscanner.png


[MITM]
hostname = *.camscanner.com, *.intsig.net

