/*************************  Quantumult X 
 
[rewrite_local]

^https:\/\/.*\.(intsig\.net|camscanner\.com) url script-response-body https://raw.githubusercontent.com/pangmf/Rules/refs/heads/master/Loon/task/CamScanner.js
[mitm]

hostname = *.camscanner.com, *.intsig.net

/*************************  Loon

#!name=扫描全能王
