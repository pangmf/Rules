#!name=Google区域搜索重定向
#!desc=将Google各地区域名自动重定向至Google主站，并保留完整搜索参数
#!author=pangmf
#!homepage=https://github.com/pangmf/rules
#!icon=https://raw.githubusercontent.com/sooyaaabo/IconLibrary/main/App/Google.png
[Script]

# 请求阶段：阻止访问 Google 区域站
http-request ^https?:\/\/(?:www\.)?google\.[a-z]{2,}(?:\.[a-z]{2})?(?:\/|$) script-path=Google-Region-Redirect.js,tag=Google区域请求重定向,timeout=10,enable=true

# 响应阶段：拦截 Google 返回的 30x 区域跳转
http-response ^https?:\/\/(?:www\.)?google\.[a-z]{2,}(?:\.[a-z]{2})?(?:\/|$) script-path=Google-Region-Redirect.js,tag=Google区域响应重定向,timeout=10,enable=true

[MITM]

hostname = %APPEND% google.*
