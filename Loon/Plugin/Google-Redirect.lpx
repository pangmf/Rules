#!name=Google区域搜索重定向
#!desc=将Google各地区域名自动重定向至Google主站，并保留完整搜索参数
#!author=pangmf
#!homepage=https://github.com/pangmf/rules
#!icon=https://www.google.com/favicon.ico

[Script]

request if ${url} ~= /^https?:\/\/(?:www\.)?google\.(?!com(?:[\/:]|$))/i then script-path=https://raw.githubusercontent.com/pangmf/Rules/refs/heads/master/Loon/task/Google-Region-Redirect.js, tag="Google区域重定向", timeout=10

[MITM]

hostname = %APPEND% google.*
