#!name=Google区域搜索重定向
#!desc=将Google各地区域名自动重定向至Google主站，并保留完整搜索参数
#!author=pangmf
#!homepage=https://github.com/pangmf/rules
#!icon=https://raw.githubusercontent.com/sooyaaabo/IconLibrary/main/App/Google.png

[Rewrite]

#Google.cn

^https?://(?:www.)?google.cn/(.*)$ https://www.google.com/$1 302

#Google.co.jp

^https?://(?:www.)?google.co.jp/(.*)$ https://www.google.com/$1 302

#Google.co.uk

^https?://(?:www.)?google.co.uk/(.*)$ https://www.google.com/$1 302

#Google.ca

^https?://(?:www.)?google.ca/(.*)$ https://www.google.com/$1 302

#Google.com.au

^https?://(?:www.)?google.com.au/(.*)$ https://www.google.com/$1 302

#Google.de

^https?://(?:www.)?google.de/(.*)$ https://www.google.com/$1 302

#Google.fr

^https?://(?:www.)?google.fr/(.*)$ https://www.google.com/$1 302

#Google.it

^https?://(?:www.)?google.it/(.*)$ https://www.google.com/$1 302

#Google.es

^https?://(?:www.)?google.es/(.*)$ https://www.google.com/$1 302

#Google.in

^https?://(?:www.)?google.in/(.*)$ https://www.google.com/$1 302

#Google.co.kr

^https?://(?:www.)?google.co.kr/(.*)$ https://www.google.com/$1 302

#Google.com.br

^https?://(?:www.)?google.com.br/(.*)$ https://www.google.com/$1 302

#Google.com.mx

^https?://(?:www.)?google.com.mx/(.*)$ https://www.google.com/$1 302

#Google.com.sg

^https?://(?:www.)?google.com.sg/(.*)$ https://www.google.com/$1 302

#Google.com.hk

^https?://(?:www.)?google.com.hk/(.*)$ https://www.google.com/$1 302

#Google.com.tw

^https?://(?:www.)?google.com.tw/(.*)$ https://www.google.com/$1 302

#Google.com.tr

^https?://(?:www.)?google.com.tr/(.*)$ https://www.google.com/$1 302

#Google.ru

^https?://(?:www.)?google.ru/(.*)$ https://www.google.com/$1 302

[MITM]

hostname = %APPEND% google.cn,.google.cn,google.co.jp,.google.co.jp,google.co.uk,.google.co.uk,google.ca,.google.ca,google.com.au,.google.com.au,google.de,.google.de,google.fr,.google.fr,google.it,.google.it,google.es,.google.es,google.in,.google.in,google.co.kr,.google.co.kr,google.com.br,.google.com.br,google.com.mx,.google.com.mx,google.com.sg,.google.com.sg,google.com.hk,.google.com.hk,google.com.tw,.google.com.tw,google.com.tr,.google.com.tr,google.ru,.google.ru
