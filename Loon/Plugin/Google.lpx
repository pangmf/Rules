#!name=Google 重定向
#!desc=将Google各地区域名自动重定向至Google主站，并保留完整搜索参数
#!author=pangmf
#!homepage=https://github.com/pangmf/rules
#!icon=https://raw.githubusercontent.com/sooyaaabo/IconLibrary/main/App/Google.png

[Rule]
# Google 全站优先 HTTP/3(QUIC/UDP 443)，而 MITM 只能解 TCP 443，所以必须把 QUIC 掐掉强制回退 TCP。
# 副作用：所有站点的 QUIC 都会被拒（浏览器会自动回退 TCP，正常网页无感，个别直播/P2P 可能变慢）。
AND,((PROTOCOL,UDP),(DEST-PORT,443)),REJECT

[Rewrite]
# google.cn 自 2010 年起已不再提供搜索，只是个跳转壳；命中后直接去 /ncr 写入"不跳区域站"的偏好
^https?://(?:www\.)?google\.cn/?$ https://www.google.com/ncr 302
^https?://(?:www\.)?google\.cn/(.*)$ https://www.google.com/$1 302

[MITM]
hostname = %APPEND% google.cn,.google.cn
