#!name=PingMe&WeTalk抓取账号参数
#!desc=打开PingMe/WeTalk停留1秒后自动获取Token，收到通知即成功。
#!author=pangmf
#!homepage=https://github.com/pangmf/rules
#!icon=https://raw.githubusercontent.com/axhani/icon/refs/heads/main/pingme&wetalk.png
#!tag=签到, Cookie

[Argument]
wetalk = switch,false,tag=WeTalk抓包,desc=打开WeTalk停留1秒后自动抓包账号，收到通知即成功。
pingme = switch,false,tag=PingMe抓包,desc=打开PingMe停留1秒后自动抓包账号，收到通知即成功。

[Script]
# 抓取 WeTalk 账号参数
http-request ^https:\/\/api\.wetalkapp\.com\/app\/(?:queryBalanceAndBonus|checkIn|videoBonus) script-path=https://raw.githubusercontent.com/pangmf/Rules/refs/heads/master/Loon/task/WeTalk.js,tag=WeTalk抓包,enable={wetalk}
# 抓取 PingMe 账号参数
http-request ^https:\/\/api\.pingmeapp\.net\/app\/queryBalanceAndBonus(?:\?.*)?$  script-path=https://raw.githubusercontent.com/pangmf/Rules/refs/heads/master/Loon/task/PingMe.js,tag=PingMe抓包, enable={pingme}

# WeTalk：每天 08:20、20:20 自动签到+视频奖励
# cron "20 8,20 * * *" then script("https://raw.githubusercontent.com/pangmf/Rules/refs/heads/master/Loon/task/WeTalk.js") with enable=false,tag="WeTalk签到",timeout=120, img_url="https://raw.githubusercontent.com/axhani/icon/refs/heads/main/pingme&wetalk.png"
# PingMe：每天 08:30、20:30 自动签到+视频奖励
# cron "30 8,20 * * *" then script("https://raw.githubusercontent.com/pangmf/Rules/refs/heads/master/Loon/task/PingMe.js") with enable=false,tag="PingMe签到",timeout=120, img_url="https://raw.githubusercontent.com/fmz200/wool_scripts/main/icons/apps/PingMe.png"

[MITM]
hostname = %APPEND% api.wetalkapp.com, api.pingmeapp.net
