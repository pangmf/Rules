#!name = 腾讯视频净化
#!desc = 去除开屏广告、播放前贴/中插广告、底部多余 Tab、我的页顶部广告。转自 TG@ZenMoFiShi
#!author = @ZenMoFiShi
#!homepage = https://github.com/ZenmoFeiShi/Qx
#!icon = https://raw.githubusercontent.com/sooyaaabo/IconLibrary/main/App/TencentVideo.png
#!date = 2026-10-27
#!tag = 广告拦截,腾讯视频
#!type = normal

[Rule]
# 广告投放域名，直接拒绝
HOST, iacc.stgw.qq.com, REJECT
HOST, tacc.video.qq.com, REJECT

[Script]
# ---------- 请求阶段：拦截 trpc 广告接口 ----------
# 对应 QX: ^https?:\/\/i\.video\.qq\.com\/(?:\?.*)?$ url script-request-body
request if ${url} ~= /^https?:\/\/i\.video\.qq\.com\/(\?.*)?$/i then script("https://raw.githubusercontent.com/pangmf/Rules/refs/heads/master/Loon/task/TxVideoAD.js") with tag="腾讯视频 trpc 广告请求", timeout=60, requires_body=true, binary_body_mode=true

# ---------- 响应阶段 ----------
# 对应 QX: ^https?:\/\/i\.video\.qq\.com\/(?:\?.*)?$ url script-response-body
response if ${url} ~= /^https?:\/\/i\.video\.qq\.com\/(\?.*)?$/i then script("https://raw.githubusercontent.com/pangmf/Rules/refs/heads/master/Loon/task/TxVideoAD.js") with tag="腾讯视频 trpc 广告响应", timeout=60, requires_body=true, binary_body_mode=true

# 对应 QX: ^https?:\/\/iacc\.qq\.com\/(?:\?.*)?$ url script-response-body（开屏/贴片/暂停广告，JCE 二进制）
response if ${url} ~= /^https?:\/\/iacc\.qq\.com\/(\?.*)?$/i then script("https://raw.githubusercontent.com/pangmf/Rules/refs/heads/master/Loon/task/TxVideoAD.js") with tag="腾讯视频 开屏/贴片/暂停广告", timeout=60, requires_body=true, binary_body_mode=true

# 对应 QX: ^https?:\/\/config\.ab\.qq\.com\/tab\/GetTabRemoteConfig(?:\?.*)?$ url script-response-body（AB 配置，二进制）
response if ${url} ~= /^https?:\/\/config\.ab\.qq\.com\/tab\/GetTabRemoteConfig(\?.*)?$/i then script("https://raw.githubusercontent.com/pangmf/Rules/refs/heads/master/Loon/task/TxVideoAD.js") with tag="腾讯视频 底部 tap 栏", timeout=60, requires_body=true, binary_body_mode=true

# 对应 QX: ^https:\/\/rdelivery\.qq\.com\/v1\/sdkconfig\/get(?:\?.*)?$ url script-response-body（纯 JSON 文本）
response if ${url} ~= /^https?:\/\/rdelivery\.qq\.com\/v1\/sdkconfig\/get(\?.*)?$/i then script("https://raw.githubusercontent.com/pangmf/Rules/refs/heads/master/Loon/task/TxVideoAD.js") with tag="腾讯视频 tab_gray", timeout=60, requires_body=true

[MITM]
hostname = %APPEND% i.video.qq.com, iacc.qq.com, config.ab.qq.com, rdelivery.qq.com
