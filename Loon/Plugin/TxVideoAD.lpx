#!name = 腾讯视频净化
#!desc = 去除开屏广告、播放前贴/中插广告、底部多余 Tab、我的页顶部广告。
#!author = TG@ZenMoFiShi
#!homepage = https://github.com/ZenmoFeiShi/Qx
#!icon = https://raw.githubusercontent.com/sooyaaabo/IconLibrary/main/App/TencentVideo.png
#!date = 2026-10-27
#!tag = 广告拦截,腾讯视频
#!type = normal


# 转换自 Quantumult X snippet: TxvideoAD.snippet
# 原始脚本: https://raw.githubusercontent.com/ZenmoFeiShi/Qx/refs/heads/main/Txvideoad.js
# 说明：
#  1. JS 使用 bodyBytes 处理二进制（protobuf/JCE），Loon 无 bodyBytes，已在脚本头部注入适配层。
#  2. 脚本规则需 binary-body-mode=true，否则读到的是字符串，无法解析二进制。
#  3. i.video.qq.com 同时需要改造请求与响应，故拆成 http-request + http-response 两条。

[Rule]
HOST,iacc.stgw.qq.com,REJECT
HOST,tacc.video.qq.com,REJECT

[Script]
http-request ^https?:\/\/i\.video\.qq\.com\/(?:\?.*)?$ script-path=scripts/TxvideoAD.loon.js, requires-body=true, binary-body-mode=true, max-size=10485760, timeout=30, tag=腾讯视频-播放请求
http-response ^https?:\/\/i\.video\.qq\.com\/(?:\?.*)?$ script-path=scripts/TxvideoAD.loon.js, requires-body=true, binary-body-mode=true, max-size=10485760, timeout=30, tag=腾讯视频-播放请求
http-response ^https?:\/\/iacc\.qq\.com\/(?:\?.*)?$ script-path=scripts/TxvideoAD.loon.js, requires-body=true, binary-body-mode=true, max-size=10485760, timeout=30, tag=腾讯视频-开屏广告
http-response ^https?:\/\/config\.ab\.qq\.com\/tab\/GetTabRemoteConfig(?:\?.*)?$ script-path=scripts/TxvideoAD.loon.js, requires-body=true, binary-body-mode=true, max-size=10485760, timeout=30, tag=腾讯视频-AB配置
http-response ^https:\/\/rdelivery\.qq\.com\/v1\/sdkconfig\/get(?:\?.*)?$ script-path=scripts/TxvideoAD.loon.js, requires-body=true, binary-body-mode=true, max-size=10485760, timeout=30, tag=腾讯视频-推荐位

[MITM]
hostname = i.video.qq.com, iacc.qq.com, config.ab.qq.com, rdelivery.qq.com
