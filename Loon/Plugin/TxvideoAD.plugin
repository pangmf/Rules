#!name = 腾讯视频净化
#!desc = 去除开屏广告、播放前贴/中插广告、底部多余 Tab、我的页顶部广告。脚本已做 Loon 二进制 body 适配。
#!author = TG@ZenMoFiShi
#!homepage = https://github.com/ZenmoFeiShi/Qx
#!icon = https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/WeTV.png
#!date = 2026-10-27
#!tag = 广告拦截,腾讯视频
#!type = normal

[Rule]
# ===== 广告上报 / 统计域名 =====
HOST, iacc.stgw.qq.com, REJECT
HOST, tacc.video.qq.com, REJECT

[Script]
# ============================================================
# ⚠️ 重要：TXvideoAD.loon.js 是经过 Loon 适配的脚本，不能直接用原作者的 QX 版本
#    （原版依赖 bodyBytes，在 Loon 中不生效且不报错）。
#    请把下面 5 处 script-path 中的 __SCRIPT_BASE__ 替换成你自己的脚本托管目录，例如：
#    https://raw.githubusercontent.com/你的用户名/你的仓库/main
# ============================================================

# 播放器 trpc 请求（前贴/中插广告清单）
http-request ^https?://i\.video\.qq\.com/(?:\?.*)?$ script-path=__SCRIPT_BASE__/TxvideoAD.loon.js,requires-body=true,binary-body-mode=true,timeout=60,tag=腾讯视频-播放请求

# 播放器 trpc 响应
http-response ^https?://i\.video\.qq\.com/(?:\?.*)?$ script-path=__SCRIPT_BASE__/TxvideoAD.loon.js,requires-body=true,binary-body-mode=true,timeout=60,tag=腾讯视频-播放响应

# 开屏广告
http-response ^https?://iacc\.qq\.com/(?:\?.*)?$ script-path=__SCRIPT_BASE__/TxvideoAD.loon.js,requires-body=true,binary-body-mode=true,timeout=60,tag=腾讯视频-开屏广告

# 底部 Tab 远程配置
http-response ^https?://config\.ab\.qq\.com/tab/GetTabRemoteConfig(?:\?.*)?$ script-path=__SCRIPT_BASE__/TxvideoAD.loon.js,requires-body=true,binary-body-mode=true,timeout=60,tag=腾讯视频-Tab配置

# 灰度开关（JSON 文本，无需二进制模式）
http-response ^https://rdelivery\.qq\.com/v1/sdkconfig/get(?:\?.*)?$ script-path=__SCRIPT_BASE__/TxvideoAD.loon.js,requires-body=true,binary-body-mode=false,timeout=60,tag=腾讯视频-灰度开关

[Mitm]
hostname = i.video.qq.com, iacc.qq.com, config.ab.qq.com, rdelivery.qq.com
