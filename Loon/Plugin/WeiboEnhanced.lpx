#!name = 微博助手功能增强
#!desc = 微博 / 微博国际版全面净化：信息流与热搜推广、开屏广告、评论区推荐、绿洲入口、关注推荐、菜单精简等。
#!author = ddgksf2013
#!homepage = https://github.com/ddgksf2013/Scripts
#!icon = https://is1-ssl.mzstatic.com/image/thumb/Purple211/v4/0d/cb/53/0dcb5343-74eb-a65a-bb19-304fe55da537/WeiboAppIcon-0-0-1x_U007epad-0-1-0-85-220.png/512x512bb.jpg
#!date = 2026-10-29
#!tag = 广告拦截,微博
#!type = normal

[Script]
# 若 GitHub raw 访问不畅，可把 script-path 换成 jsDelivr：
# https://cdn.jsdelivr.net/gh/ddgksf2013/Scripts@master/weibo_json.js
# ---------- 微博主接口：信息流 / 搜索 / 个人页 / 评论 / 签到 ----------
^https?://api\.weibo\.cn(?:/2/statuses/container_timeline_hot|/2/guest/container_timeline_hot|/2/statuses/container_timeline_unread|/2/statuses/container_timeline|/2/live/media_homelist|/2/remind/hometab_dot|/2/remind/unread_count|/2/statuses/container_detail|/2/statuses/container_detail_comment|/2/comments/build_comments|/2/search/finder|/2/search/container_timeline|/2/search/container_discover|/2/!/was/finder/searchbarchange|/2/cardlist|/2/searchall|/2/profile/me|/2/profile/container_timeline|/2/video/flow_stream|/2/video/flow_stream_cache|/2/push/daily|/2/push/active|/2/guest/push_active|/2/groups/allgroups/v2|/2/client/abserver_list|/2/checkin/show|/2/video/remind_info|/2/video/home_channels)(?=[?#]|$) script-path=https://ddgksf2013.top/scripts/weibo_json.js, requires-body=true, timeout=60, tag=微博净化-微博接口

# ---------- 开屏广告：预加载 ----------
^https?://bootpreload\.uve\.weibo\.com(?:/v2/ad/preload)(?=[?#]|$) script-path=https://ddgksf2013.top/scripts/weibo_json.js, requires-body=true, timeout=60, tag=微博净化-开屏预加载

# ---------- 开屏广告：实时 ----------
^https?://bootrealtime\.uve\.weibo\.com(?:/v3/ad/realtime)(?=[?#]|$) script-path=https://ddgksf2013.top/scripts/weibo_json.js, requires-body=true, timeout=60, tag=微博净化-开屏实时

# ---------- 开屏广告：Lua 接口 ----------
^https?://wbapp\.uve\.weibo\.com(?:/wbapplua/wbpullad\.lua)(?=[?#]|$) script-path=https://ddgksf2013.top/scripts/weibo_json.js, requires-body=true, timeout=60, tag=微博净化-开屏素材

# --- 以下两条对应 QX 的 echo 类规则，Loon 暂不原生支持，按需手动启用 ---
# http-request ^https://api\.weibo\.cn/__qx_weibo_settings__/(?:api/config)?(?=[?#]|$) script-path=https://ddgksf2013.top/scripts/weibo_json.js, requires-body=false, timeout=60, tag=微博净化-设置读取
# http-request ^https://api\.weibo\.cn/__qx_weibo_settings__/api/(?:save|reset)(?=[?#]|$) script-path=https://ddgksf2013.top/scripts/weibo_json.js, requires-body=false, timeout=60, tag=微博净化-设置写入

[Mitm]
hostname = api.weibo.cn, bootpreload.uve.weibo.com, bootrealtime.uve.weibo.com, wbapp.uve.weibo.com

