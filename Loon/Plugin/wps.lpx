#!name=极氪汽车签到
#!desc= 打开极氪app自动获取Token，收到通知即成功。
#!author=pangmf
#!homepage=https://github.com/pangmf/rules
#!icon=https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/wps.png
#!tag=签到, Cookie

[Argument]
wps = switch,false,tag=WPS Cookie,desc=打开极氪app自动触发


[Script]
http-request ^https:\/\/personal-act\.wps\.cn\/activity-rubik\/activity\/page_info tag=WPS Cookie, script-path=https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/main/app/wps/wps.cookie.js, requires-body=false, img-url=https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/wps.png, enable={wps}
#cron "0 10 * * *" script-path=https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/main/app/wps/wps.js, tag=WPS签到, img-url=https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/wps.png, enable=true

[MITM]
hostname = personal-act.wps.cn
